# Makefile.conf for Apple-silicon macOS (tested MacBook Pro M3 Max, 2026-08-29). See INSTALL.mac.m3max
# Toolchain: MacPorts mpich-gcc13 (gfortran 13) -- the only wrapper whose mpi.mod
# matches the gfortran-13/14 module format of ESMF, COMIO, PNetCDF, libIE, libIO.
# Derived from Makefile.conf.macOS (Homebrew layout), adapted to ~/*_install dirs.

SHELL=/bin/sh

MPIFORT = /opt/local/bin/mpifort-mpich-gcc13

# Define compilers and linker:
COMPILE.f77 = ${MPIFORT}
COMPILE.f90 = ${MPIFORT}
LINK.f90 = ${MPIFORT}
AR = ar -rs

# Define precision:
SINGLEPREC = -frecord-marker=4
DOUBLEPREC = -frecord-marker=4 -fdefault-real-8 -fdefault-double-8
PRECISION  =

# Dependency install directories
ESMF_INSTALL_DIR = ${HOME}/ESMF_install
ESMF_ARCH = Darwin.gfortranclang.64.mpich.default
COMIO_INSTALL_DIR = ${HOME}/COMIO_install
PNETCDF_INSTALL_DIR = ${HOME}/pnetcdf_install

# These are all the places to look for include and mod files:
FORTRANMODULES =
INCLUDEDIR = -I${SHAREDDIR} -I${IODIR}/src -I${MILEDIR}/src
HDF5INCLUDE =
NETCDFINCLUDE =
PNETCDFINCLUDE = -I${PNETCDF_INSTALL_DIR}/include
COMIOINCLUDE = -I${COMIO_INSTALL_DIR}/include
ESMFMODULES = -I${ESMF_INSTALL_DIR}/mod/modg/${ESMF_ARCH}
ESMFINCLUDE = -I${ESMF_INSTALL_DIR}/include
SEARCH = ${FORTRANMODULES} ${INCLUDEDIR} ${HDF5INCLUDE} ${NETCDFINCLUDE} ${PNETCDFINCLUDE} ${COMIOINCLUDE} ${ESMFMODULES} ${ESMFINCLUDE} ${EXTRASEARCH}

# These are places to look for libraries:
IPELIBDIRS = -L${MILEDIR}/lib -L${IODIR}/lib -L${LIBDIR}
SYSTEMLIBDIRS = -L${ESMF_INSTALL_DIR}/lib/libg/${ESMF_ARCH} -L${COMIO_INSTALL_DIR}/lib -L${PNETCDF_INSTALL_DIR}/lib

# These are the libraries:
IPELIBS = -lIPE -lEfield -lDynamo -lFlip -lMsise -lShared -lIE -lIO
# libesmf.dylib carries its own Open MPI dylib dependencies (resolved by path at load time);
# COMIO was built --without-hdf5, so no HDF5/NetCDF needed.
SYSTEMLIBS = -Wl,-rpath,${ESMF_INSTALL_DIR}/lib/libg/${ESMF_ARCH} -lesmf -lcomio -lpnetcdf -lc++ -lm

# These are the preprocessor options:
PreProc = -DHAVE_MPI -DHAVE_MILE -DNEEDMODTIMECONVERT -DNEEDMODIOUNIT

# If you need some debug flags, set DEBUG = ${DEBUGFLAG}:
DEBUGFLAG = -C -g -fbacktrace -ffpe-trap=invalid,zero,overflow -fcheck=all
DEBUG =

# Define some flags:
F77FLAGS =  -fno-unsafe-math-optimizations -ffixed-line-length-132

OPT0 = -O0
OPT1 = -O1
OPT2 = -O2
OPT3 = -O3
OPT4 = -O4

CFLAG = ${SEARCH} -w ${DEBUG} -fallow-argument-mismatch -ffree-line-length-none

Cflag0  = ${CFLAG} ${PRECISION} ${OPT0}
Cflag1  = ${CFLAG} ${PRECISION} ${OPT1}
Cflag2  = ${CFLAG} ${PRECISION} ${OPT2}
Cflag3  = ${CFLAG} ${PRECISION} ${OPT3}
Cflag4  = ${CFLAG} ${PRECISION} ${OPT4}

#
#       General rules
#

.SUFFIXES:
.SUFFIXES: .f90 .F90 .f .for .ftn .o

.f90.o:
	${COMPILE.f90} -c ${Cflag2} $<

.F90.o:
	${COMPILE.f90} -c ${PreProc} ${Cflag2} $<

.f.o:
	${COMPILE.f77} -c ${Cflag2} ${F77FLAGS} $<

.for.o:
	${COMPILE.f77} -c ${Cflag2} -ffixed-line-length-132 $<

.ftn.o:
	${COMPILE.f77} -c ${Cflag2} -ffixed-line-length-132 $<

clean:
	rm -f *~ core *.o *.mod fort.* a.out *.exe *.a *.so *.protex ${MY_LIB}
