
SHELL=/bin/sh

COMPILE.f77     = ${CUSTOMPATH_F}mpif90
COMPILE.f90     = ${CUSTOMPATH_F}mpif90
LINK.f90	= ${CUSTOMPATH_MPI}mpif90
AR = ar -rs

SINGLEPREC = -frecord-marker=4
DOUBLEPREC = -frecord-marker=4 -fdefault-real-8 -fdefault-double-8
PRECISION  =
# ${DOUBLEPREC} ${MEM}

FORTRANMODULES = -I/usr/lib64/gfortran/modules/
COMIOINCLUDE = -I/mnt/data5/ipedir/COMIO/install/include
INCLUDEDIR = -I/usr/include ${COMIOINCLUDE} -I${SHAREDDIR} -I${IODIR}/src -I${MILEDIR}/src
ESMFMODULES = -I/home/aaronbuk/.local/spack/opt/spack/linux-zen2/esmf-8.8.1-2amtokp3ytoruld3row7qkxvzfoptkah/include
SEARCH = ${FORTRANMODULES} ${INCLUDEDIR} ${HDF5INCLUDE} ${ESMFMODULES} ${ESMFINCLUDE} ${EXTRASEARCH}

# These are places to look for libraries:
IPELIBDIRS = -L${MILEDIR}/lib -L${LIBDIR}
PNETCDFLIB = -L/home/aaronbuk/.local/spack/opt/spack/linux-zen2/parallel-netcdf-1.14.0-ow567cglgughojjuuorrkeqkd2rh4utb/lib
SYSTEMLIBDIRS = -L/usr/lib64 -L/mnt/data5/ipedir/COMIO/install/lib ${PNETCDFLIB}

# and these are the libraries:
IPELIBS = -lIPE -lEfield -lDynamo -lFlip -lMsise -lShared -lIE -lIO
SYSTEMLIBS = -lcomio -lhdf5hl_fortran -lhdf5_hl -lhdf5_fortran -lhdf5 -lcrypto -lcurl -lsz -lz -ldl -lm -lpnetcdf

PreProc = -DHAVE_MPI -DHAVE_MILE -DNEEDMODTIMECONVERT -DNEEDMODIOUNIT

DEBUGFLAG = -C -g -fbacktrace -ffpe-trap=invalid,zero,overflow -fcheck=all
DEBUG     = 

F77FLAGS =  -fno-unsafe-math-optimizations -ffixed-line-length-132

OPT0 = -O0
OPT1 = -O1
OPT2 = -O2
OPT3 = -O3
OPT4 = -O4

CFLAG = ${SEARCH} -w ${DEBUG} -fallow-argument-mismatch

Cflag0  = ${CFLAG} ${PRECISION} ${OPT0}
Cflag1  = ${CFLAG} ${PRECISION} ${OPT1}
Cflag2  = ${CFLAG} ${PRECISION} ${OPT2}
Cflag3  = ${CFLAG} ${PRECISION} ${OPT3}
Cflag4  = ${CFLAG} ${PRECISION} ${OPT4}

#
#       General rules
#

.SUFFIXES:
.SUFFIXES: .f90 .F90 .f .for .ftn .o

.f90.o:
	${COMPILE.f90} -c ${Cflag2} $<

.F90.o:
	${COMPILE.f90} -c ${PreProc} ${Cflag2} $<

.f.o:
	${COMPILE.f77} -c ${Cflag2} ${F77FLAGS} $<

.for.o:
	${COMPILE.f77} -c ${Cflag2} -ffixed-line-length-132 $<

.ftn.o:
	${COMPILE.f77} -c ${Cflag2} -ffixed-line-length-132 $<

clean:	
	rm -f *~ core *.o *.mod fort.* a.out *.exe *.a *.so *.protex ${MY_LIB}

