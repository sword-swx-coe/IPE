&SPACEMANAGEMENT
 GRID_FILE = 'IPE_Grid.nc',
/
&TIMESTEPPING
 TIME_STEP   = 300D0,
 START_TIME  = 0.0D0,
 END_TIME    = 14400.0D0,
 MSIS_TIME_STEP   = 300.D0,
 INITIAL_TIMESTAMP = 201303160000,
/
&FORCING
 SOLAR_FORCING_TIME_STEP = 60.0D0,
 F107_KP_SIZE            = 0,
 F107_KP_INTERVAL        = 0,
 F107_KP_SKIP_SIZE       = 0,
 F107_KP_DATA_SIZE       = 0,
 F107_KP_READ_IN_START   = 0,
 F107_KP_FILE            = './ipe_yyyymmdd.txt',
 F107_KP_REALTIME_INTERVAL = 0,
/
&FILEIO
 READ_APEX_NEUTRALS        = T,
 WRITE_APEX_NEUTRALS       = T,
 WRITE_GEOGRAPHIC_NEUTRALS = T,
 FILE_OUTPUT_FREQUENCY     = 1800.0D0,
 FILE_PREFIX               = 'IPE_State.apex.',
 FILE_EXTENSION            = '.nc',
 INPUT_FILE_DIR = "UA/dataIn/",
/
&ipecap
  mesh_height_min = 0.,
  mesh_height_max = 2000.,
  mesh_write      = 0,
  mesh_write_file = 'ipemesh',
  mesh_fill       = 1,
/
&ELDYN
  DYNAMO_EFIELD = F,
/
&OPERATIONAL
  COLFAC                 = 1.3,
  OFFSET1_DEG            = 5.0,
  OFFSET2_DEG            = 20.0,
  POTENTIAL_MODEL        = 2,
  HPEQ                   = 0.0,
  TRANSPORT_HIGHLAT_LP   = 30,
  PERP_TRANSPORT_MAX_LP  = 151,
  VERTICAL_WIND_LIMIT    = 100.0,
  ! EXB_HEMISPHERIC: 0 = one ExB drift per flux tube from the NH footpoint (legacy),
  !   1 = separate NH/SH drifts, each hemispheric leg transported with its own drift.
  !   Remove this line for binaries older than this option (the namelist read error is
  !   silently ignored). The 2-D output names changed with it:
  !   ExB_East -> ExB_apex_e1_N, ExB_North -> ExB_apex_e2_N, plus new ExB_apex_e1_S/e2_S.
  EXB_HEMISPHERIC        = 0,
/
&MILE
  MILE_VERBOSE = 2,
  MILE_EFIELD = 'none',
  MILE_AURORA = 'none',
  MILE_DIR = './extIE/',
  AMIEFILENORTH = 'none',
  AMIEFILESOUTH = 'none'
/
